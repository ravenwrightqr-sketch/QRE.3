{
  "name": "qre.3",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm author:guard && pnpm author:wiring && pnpm build:contracts && pnpm build:db && pnpm build:engine && pnpm build:api && pnpm author:metamorphic-foundation && pnpm build:web",
    "author:guard": "node ./scripts/verify-author-architecture.mjs && node ./scripts/verify-author-reachability.mjs && node ./scripts/verify-contract-ownership.mjs && node ./scripts/verify-no-legacy-engine-cognition.mjs && node ./scripts/verify-author-production-gate.mjs",
    "author:production-gate": "node ./scripts/verify-author-production-gate.mjs",
    "author:wiring": "node ./scripts/verify-author-wiring.mjs",
    "author:reachability": "node ./scripts/verify-author-reachability.mjs",
    "author:lens-boundary": "pnpm --filter @qre/api exec tsx ./author-lens-boundary-acceptance.ts",
    "author:world-simulation": "pnpm --filter @qre/api exec tsx ./author-world-simulation-acceptance.ts",
    "author:world-wiring": "pnpm --filter @qre/api exec tsx ./author-world-simulation-wiring-acceptance.ts",
    "author:persistence": "pnpm --filter @qre/api exec tsx ./author-runtime-persistence-acceptance.ts",
    "author:universal-final": "pnpm --filter @qre/api exec tsx ./author-universal-final-acceptance.ts",
    "author:universal-learning-loop": "pnpm --filter @qre/api exec tsx ./author-universal-learning-loop-acceptance.ts",
    "author:living-sequence": "pnpm --filter @qre/api exec tsx ./author-living-sequence-acceptance.ts",
    "author:metamorphic-foundation": "pnpm --filter @qre/api exec tsx ./author-metamorphic-foundation-acceptance.ts",
    "build:contracts": "pnpm --filter @qre/contracts build",
    "build:db": "pnpm --filter @qre/db build",
    "build:engine": "pnpm --filter @qre/engine build",
    "build:api": "pnpm --filter @qre/api build",
    "build:web": "pnpm --filter @qre/web build",
    "db:migrate": "pnpm --filter @qre/db prisma:deploy",
    "verify:experience-media-boundary": "node scripts/verify-experience-media-boundary.mjs",
    "clean": "pnpm -r clean"
  },
  "pnpm": {
    "overrides": {
      "@qre/contracts": "workspace:*",
      "@qre/engine": "workspace:*",
      "@qre/db": "workspace:*"
    }
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "20",
    "prisma": "6.19.3",
    "tsx": "^4.22.4",
    "typescript": "5.5.4"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcrypt": "^6.0.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "bcrypt": "^6.0.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "stripe": "^22.2.1",
    "zod": "^4.4.3",
    "zustand": "5.0.14"
  }
}
