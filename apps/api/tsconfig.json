{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,

    "forceConsistentCasingInFileNames": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,

    /**
     * =========================
     * MONOREPO WORKSPACE FIX
     * =========================
     */
    "baseUrl": ".",
    "paths": {
      "@qre/contracts": ["../../packages/contracts/src"],
      "@qre/engine": ["../../packages/engine/src"],
      "@qre/db": ["../../packages/db/src"]
    }
  },

  "include": ["src"],

  "exclude": [
    "node_modules",
    "dist"
  ]
}