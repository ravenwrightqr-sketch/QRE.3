{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "skipLibCheck": true,

    "types": ["node"],

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "noEmit": true
  },
  "include": [
    "./author-acceptance-monster.ts",
    "./author-acceptance-suite.ts",
    "./author-enterprise-realization-selfcheck.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
