generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  password         String
  tier             String        @default("BASIC")
  tierActive       Boolean       @default(true)
  stripeCustomerId String?
  createdAt        DateTime      @default(now())
  phone            String?
  AccountUser      AccountUser[]
  Asset            Asset[]
  Ownership        Ownership[]
  sessions         ScanSession[]
}

model Asset {
  id                String            @id @default(cuid())
  slug              String            @unique
  qrUrl             String?
  qrSvg             String?
  saleChannel       SaleChannel       @default(RETAIL)
  templateId        String?
  merchantId        String?
  category          TemplateCategory?
  templateData      Json?
  ownerId           String?
  token             String            @unique @default(cuid())
  status            String            @default("active")
  claimedAt         DateTime?
  createdAt         DateTime          @default(now())
  paid              Boolean           @default(false)
  activationMethod  ActivationMethod  @default(HYBRID)
  activationCode    String?           @unique
  nfcUid            String?            @unique
  priceCents        Int               @default(599)
  premiumPriceCents Int?
  totalRevenueCents Int               @default(0)
  totalScans        Int               @default(0)
  totalUnlocks      Int               @default(0)
  displayName       String?
  accountId         String?
  stateConfig       Json?
  analyticsEvents   AnalyticsEvent[]
  User              User?             @relation(fields: [ownerId], references: [id])
  account           Account?          @relation(fields: [accountId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  template          Template?         @relation(fields: [templateId], references: [id])
  flows             AssetFlow[]
  claims            Claim[]
  experiences       Experience[]
  memorySnapshots   MemorySnapshot[]
  ownership         Ownership?
  scanEvents        ScanEvent[]
  sessions          ScanSession[]
  eventTickets      EventTicket[]

  @@index([slug])
  @@index([ownerId])
  @@index([accountId])
}

model Account {
  id               String        @id @default(cuid())
  name             String
  type             String?       @default("CONSUMER")
  plan             String?       @default("BASIC")
  createdAt        DateTime?     @default(now()) @db.Timestamp(6)
  stripeCustomerId String?
  AccountUser      AccountUser[]
  ownerships       Ownership[]
  assets           Asset[]
}

model AccountUser {
  id        String  @id @default(cuid())
  accountId String  @map("accountid")
  userId    String  @map("userid")
  role      String? @default("OWNER")
  Account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "accountuser_account_fkey")
  User      User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "accountuser_user_fkey")
  @@unique([accountId, userId], map: "accountuser_unique")
}

model Ownership {
  id              String          @id @default(cuid())
  assetId         String          @unique
  userId          String?
  status          OwnershipStatus @default(CLAIMED)
  claimedAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  stripeSessionId String?         @unique
  paymentIntentId String?
  accountId       String?
  account         Account?        @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  asset           Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  User            User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([accountId])
  @@index([userId])
}

model Flow {
  id         String  @id @default(cuid())
  name       String
  version    Int     @default(1)
  merchantId String?
  actions    Json
  data Json?
  createdAt       DateTime           @default(now())
  status          String             @default("DRAFT")
  publishedAt     DateTime?
  analyticsEvents AnalyticsEvent[]
  assetFlows      AssetFlow[]
  metrics         FlowMetricsDaily[]
  steps           FlowStep[]         @relation("FlowSteps")
  sessions        ScanSession[]
  experiences Experience[] @relation("ExperienceFlow")
  publishedExperiences Experience[] @relation("PublishedExperienceFlow")
}

model AssetFlow {
  id          String    @id @default(cuid())
  assetId     String
  flowId      String
  priority    Int       @default(0)
  active      Boolean   @default(true)
  triggerType String    @default("DEFAULT")
  startTime   DateTime?
  endTime     DateTime?
  createdAt   DateTime  @default(now())
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  flow        Flow      @relation(fields: [flowId], references: [id], onDelete: Cascade)
  @@unique([assetId, flowId])
  @@index([assetId])
  @@index([flowId])
}

model ScanSession {
  id              String           @id @default(cuid())
  userId          String?
  assetId         String
  flowId          String?
  startedAt       DateTime         @default(now())
  endedAt         DateTime?
  stepIndex       Int              @default(0)
  status          String           @default("active")
  ipAddress       String?
  country         String?
  region          String?
  city            String?
  userAgent       String?
  lastAction      Json?
  cinematicScenes Json?
  completedAt     DateTime?
  geoStory        Json?
  memorySnapshot  Json?
  moments         Json?
  receipt         Json?
  analyticsEvents AnalyticsEvent[]
  events          ScanEvent[]
  asset           Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  flow            Flow?            @relation(fields: [flowId], references: [id])
  user            User?            @relation(fields: [userId], references: [id])
  @@index([assetId])
  @@index([flowId])
  @@index([userId])
}

model ScanEvent {
  id        String       @id @default(cuid())
  userId    String?
  assetId   String
  sessionId String?
  type      String
  meta      Json?
  createdAt DateTime     @default(now())
  asset     Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  session   ScanSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model AnalyticsEvent {
  id        String             @id @default(cuid())
  assetId   String
  sessionId String?
  flowId    String?
  stepIndex Int?
  type      AnalyticsEventType
  meta      Json?
  createdAt DateTime           @default(now())
  asset     Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  flow      Flow?              @relation(fields: [flowId], references: [id])
  session   ScanSession?       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([assetId])
  @@index([flowId])
  @@index([sessionId])
  @@index([type])
  @@index([createdAt])
}

model AdminSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

model FlowExecution {
  id        String   @id @default(cuid())