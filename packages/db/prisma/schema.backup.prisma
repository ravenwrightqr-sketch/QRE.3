generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  password         String
  tier             String        @default("BASIC")
  tierActive       Boolean       @default(true)
  stripeCustomerId String?
  createdAt        DateTime      @default(now())
  phone            String?
  AccountUser      AccountUser[]
  Asset            Asset[]
  Ownership        Ownership[]
  sessions         ScanSession[]
}

model Asset {
  id                String            @id @default(cuid())
  slug              String            @unique
  qrUrl             String?
  qrSvg             String?
  saleChannel       SaleChannel       @default(RETAIL)
  templateId        String?
  merchantId        String?
  category          TemplateCategory?
  templateData      Json?
  ownerId           String?
  token             String            @unique @default(cuid())
  status            String            @default("active")
  claimedAt         DateTime?
  createdAt         DateTime          @default(now())
  paid              Boolean           @default(false)
  activationMethod  ActivationMethod  @default(HYBRID)
  activationCode    String?           @unique
  nfcUid            String?           @unique
  priceCents        Int               @default(599)
  premiumPriceCents Int?
  totalRevenueCents Int               @default(0)
  totalScans        Int               @default(0)
  totalUnlocks      Int               @default(0)
  displayName       String?
  accountId         String?
  account           Account?          @relation(fields: [accountId], references: [id])
  analyticsEvents   AnalyticsEvent[]
  User              User?             @relation(fields: [ownerId], references: [id])
  template          Template?         @relation(fields: [templateId], references: [id])
  flows             AssetFlow[]
  claims            Claim[]
  memorySnapshots   MemorySnapshot[]
  ownership         Ownership?
  scanEvents        ScanEvent[]
  sessions          ScanSession[]
  experiences       Experience[]

  @@index([slug])
  @@index([ownerId])
}

model Account {
  id               String        @id @default(cuid())
  name             String
  type             String?       @default("CONSUMER")
  plan             String?       @default("BASIC")
  createdAt        DateTime?     @default(now()) @db.Timestamp(6)
  stripeCustomerId String?
  assets           Asset[]
  AccountUser      AccountUser[]
  ownerships       Ownership[]
}

model AccountUser {
  id        String  @id @default(cuid())
  accountId String  @map("accountid")
  userId    String  @map("userid")
  role      String? @default("OWNER")

  Account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  User    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, userId], map: "accountuser_unique")
  @@index([accountId])
  @@index([userId])
}

model Ownership {
  id              String          @id @default(cuid())
  assetId         String          @unique
  userId          String?
  status          OwnershipStatus @default(CLAIMED)
  claimedAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  stripeSessionId String?         @unique
  paymentIntentId String?
  accountId       String?
  account         Account?        @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  asset           Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  User            User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([userId])
}

/// *
/// * =========================
/// * FLOW ENGINE
/// * =========================
model Flow {
  id String @id @default(cuid())

  name       String
  version    Int     @default(1)
  merchantId String?
  actions    Json

  /// *
  /// * =========================
  /// * EXPERIENCE WORLD
  /// * =========================
  /// *
  /// * Compiler output:
  /// *
  /// * Genome
  /// *   ↓
  /// * World
  /// *   ↓
  /// * Flow Runtime
  /// *
  experienceDNA Json?
  worldDomain   String?
  archetype     String?

  /// *
  /// * =========================
  /// * OPTIONAL CONFIG ONLY
  /// * =========================
  data Json?

  createdAt DateTime @default(now())

  analyticsEvents AnalyticsEvent[]
  assetFlows      AssetFlow[]
  metrics         FlowMetricsDaily[]
  steps           FlowStep[]         @relation("FlowSteps")
  sessions        ScanSession[]
  experience      Experience?        @relation(fields: [experienceId], references: [id])
  experienceId    String?
}

model AssetFlow {
  id          String    @id @default(cuid())
  assetId     String
  flowId      String
  priority    Int       @default(0)
  active      Boolean   @default(true)
  triggerType String    @default("DEFAULT")
  startTime   DateTime?
  endTime     DateTime?
  createdAt   DateTime  @default(now())
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  flow        Flow      @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([assetId, flowId])
  @@index([assetId])
  @@index([flowId])
}

/// *
/// * =========================
/// * SCAN SESSION
/// * =========================
model ScanSession {
  id              String           @id @default(cuid())
  userId          String?
  assetId         String
  flowId          String?
  startedAt       DateTime         @default(now())
  endedAt         DateTime?
  stepIndex       Int              @default(0)
  status          String           @default("active")
  ipAddress       String?
  country         String?
  region          String?
  city            String?
  userAgent       String?
  lastAction      Json?
  cinematicScenes Json?
  completedAt     DateTime?
  geoStory        Json?
  memorySnapshot  Json?
  moments         Json?
  receipt         Json?
  analyticsEvents AnalyticsEvent[]
  events          ScanEvent[]
  asset           Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  flow            Flow?            @relation(fields: [flowId], references: [id])
  user            User?            @relation(fields: [userId], references: [id])

  @@index([assetId])
  @@index([flowId])
  @@index([userId])
}

/// *
/// * =========================
/// * SCAN EVENT
/// * =========================
model ScanEvent {
  id        String       @id @default(cuid())
  userId    String?
  assetId   String
  sessionId String?
  type      String
  meta      Json?
  createdAt DateTime     @default(now())
  asset     Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  session   ScanSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

/// *
/// * =========================
/// * ANALYTICS EVENTS
/// * =========================
model AnalyticsEvent {
  id        String             @id @default(cuid())
  assetId   String
  sessionId String?
  flowId    String?
  stepIndex Int?
  type      AnalyticsEventType
  meta      Json?
  createdAt DateTime           @default(now())
  asset     Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  flow      Flow?              @relation(fields: [flowId], references: [id])
  session   ScanSession?       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([flowId])
  @@index([sessionId])
  @@index([type])
  @@index([createdAt])
}

/// *
/// * =========================
/// * ADMIN SETTINGS
/// * =========================
model AdminSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

/// *
/// * =========================
/// * STRIPE EVENT DEDUP
/// * =========================
model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

/// *
/// * =========================
/// * FLOW EXECUTION TRACKING
/// * =========================
model FlowExecution {
  id        String   @id @default(cuid())
  sessionId String
  flowId    String
  assetId   String
  status    String   @default("running")
  createdAt DateTime @default(now())

  @@unique([sessionId, flowId])
  @@index([assetId])
  @@index([flowId])
}

/// *
/// * =========================
/// * FLOW METRICS
/// * =========================
model FlowMetricsDaily {
  id                String   @id @default(cuid())
  flowId            String
  date              DateTime
  scans             Int      @default(0)
  sessions          Int      @default(0)
  completions       Int      @default(0)
  unlocks           Int      @default(0)
  payments          Int      @default(0)
  revenueCents      Int      @default(0)
  avgSessionSeconds Float    @default(0)
  conversionRate    Float    @default(0)
  flowScore         Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  flow              Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, date])
  @@index([date])
}

/// *
/// * =========================
/// * CLAIM
/// * =========================
model Claim {
  id        String      @id @default(cuid())
  assetId   String
  userId    String
  stripeId  String?     @unique
  status    ClaimStatus @default(PENDING)
  createdAt DateTime    @default(now())
  expiresAt DateTime
  asset     Asset       @relation(fields: [assetId], references: [id])

  @@index([assetId])
  @@index([userId])
}

/// *
/// * =========================
/// * TEMPLATE SYSTEM (FIXED)
/// * =========================
model Template {
  id                 String           @id @default(cuid())
  name               String
  slug               String           @unique
  category           TemplateCategory
  description        String?
  signals            Json
  schema             Json
  aiPrompt           String?
  allowPersonalLayer Boolean          @default(true)
  allowMemoryFeed    Boolean          @default(false)
  published          Boolean          @default(true)
  version            Int              @default(1)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  assets             Asset[]

  @@index([category])
}

model Insight {
  id        String   @id @default(cuid())
  assetId   String
  type      String
  message   String
  impact    String?
  createdAt DateTime @default(now())

  @@index([assetId])
}

model MemorySnapshot {
  id                   String   @id @default(cuid())
  assetId              String
  userId               String?
  sessionId            String?
  scanWeight           Float    @default(0)
  flowEngagementWeight Float    @default(0)
  completionWeight     Float    @default(0)
  ctaClickWeight       Float    @default(0)
  rewardScore          Float    @default(0)
  confidence           Float    @default(0)
  dominantLayer        String?
  createdAt            DateTime @default(now())
  dropOffPoints        Json     @default("{}")
  asset                Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, createdAt])
  @@index([assetId])
  @@index([createdAt])
}

model FlowStep {
  id      String @id @default(cuid())
  flowId  String
  order   Int
  type    String
  payload Json
  flow    Flow   @relation("FlowSteps", fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId])
}

model GeoProof {
  id        String   @id @default(cuid())
  assetId   String
  sessionId String?
  userId    String?
  lat       Float
  lng       Float
  accuracy  Float?
  createdAt DateTime @default(now())
  source    String   @default("scan")
  label     String?
  city      String?
  region    String?
  country   String?

  @@index([assetId])
  @@index([sessionId])
}

model PresenceEvent {
  id        String   @id @default(cuid())
  assetId   String
  userId    String?
  sessionId String?
  type      String
  lat       Float?
  lng       Float?
  accuracy  Float?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([assetId])
  @@index([sessionId])
  @@index([userId])
}

model PresenceSession {
  id        String         @id @default(cuid())
  assetId   String
  userId    String?
  status    PresenceStatus
  enteredAt DateTime       @default(now())
  exitedAt  DateTime?
  geoLat    Float?
  geoLng    Float?
  accuracy  Float?
  createdAt DateTime       @default(now())
  sessionId String?

  @@index([assetId])
  @@index([sessionId])
  @@index([userId])
}

model EventTicket {
  id         String       @id @default(cuid())
  assetId    String
  userId     String?
  status     TicketStatus @default(ACTIVE)
  redeemedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([assetId])
  @@index([userId])
}

model EventAttendance {
  id        String   @id @default(cuid())
  assetId   String
  userId    String?
  sessionId String?
  eventId   String?
  status    String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([assetId])
  @@index([sessionId])
  @@index([userId])
}

model MerchantSignal {
  id         String    @id
  merchantId String
  assetId    String?
  type       String
  text       String?
  url        String?
  label      String?
  data       Json?
  active     Boolean   @default(true)
  priority   Int       @default(50)
  startsAt   DateTime?
  endsAt     DateTime?
  isPublic   Boolean   @default(true)
  likes      Int       @default(0)
  views      Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime

  @@index([active])
  @@index([assetId])
  @@index([merchantId])
  @@index([startsAt, endsAt])
}

/// *
/// * =========================
/// * TEMPLATE CATEGORY (SINGLE SOURCE OF TRUTH)
/// * =========================
enum TemplateCategory {
  PERSONAL
  GENERIC
  MERCHANT
  SERVICE
  WEED_SHOP
  AIRBNB
  REAL_ESTATE
  PET_RESCUE
  BUSINESS
  ARTIST
}

/// *
/// * =========================
/// * ACTIVATION METHOD
/// * =========================
enum ActivationMethod {
  NFC
  SLUG
  HYBRID
}

enum OwnershipStatus {
  CLAIMED
  ACTIVE
  REVOKED
  REFUNDED
}

enum SaleChannel {
  RETAIL
  ONLINE
  ADMIN
}

/// *
/// * =========================
/// * ANALYTICS EVENT TYPES
/// * =========================
enum AnalyticsEventType {
  SCAN
  SESSION_START
  SESSION_END
  FLOW_START
  FLOW_STEP
  FLOW_COMPLETE
  FLOW_ABANDON
  AI_MEMORY_USED
  AI_DECISION
  CTA_CLICK
  REDIRECT
  PAYMENT_REQUIRED
  PAYMENT_STARTED
  PAYMENT_COMPLETED
  UNLOCK
  CLAIM_STARTED
  CLAIM_COMPLETED
  TEASER_VIEW
  GEO_MARK
  WEBSITE_CLICK
  SOCIAL_CLICK
  TIP_STARTED
  TIP_COMPLETED
  ERROR
  FLOW_POLICY_APPLIED
  CHECK_IN
  CHECK_OUT
  PRESENCE_JOIN
  PRESENCE_LEAVE
}

enum ClaimStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum PresenceStatus {
  ENTERED
  INSIDE
  LEFT
}

enum TicketStatus {
  ACTIVE
  REDEEMED
  VOID
}

/// *
/// * =========================
/// * EXPERIENCE SOURCE
/// * =========================
/// *
/// * Creative truth layer.
/// *
/// * Stores:
/// * - Genome
/// * - World
/// * - Blueprint
/// *
/// * Compiles into Flow.
/// *
model Experience {
  id String @id @default(cuid())

  assetId String?

  name String

  version Int @default(1)

  status String @default("DRAFT")

  genome Json

  world Json

  blueprint Json

  metadata Json?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  asset Asset? @relation(fields: [assetId], references: [id], onDelete: Cascade)

  flows Flow[]

  @@index([assetId])
}
