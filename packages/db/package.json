{
  "name": "@qre/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ./scripts/with-db-env.mjs prisma generate --schema=./prisma/schema.prisma && tsc -p tsconfig.json",
    "prisma:validate": "node ./scripts/with-db-env.mjs prisma validate --schema=./prisma/schema.prisma",
    "prisma:status": "node ./scripts/with-db-env.mjs prisma migrate status --schema=./prisma/schema.prisma",
    "prisma:generate": "node ./scripts/with-db-env.mjs prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate": "node ./scripts/with-db-env.mjs prisma migrate dev --schema=./prisma/schema.prisma",
    "prisma:deploy": "node ./scripts/with-db-env.mjs prisma migrate deploy --schema=./prisma/schema.prisma",
    "prisma:push": "node ./scripts/with-db-env.mjs prisma db push --schema=./prisma/schema.prisma",
    "db:studio": "node ./scripts/with-db-env.mjs prisma studio --schema=./prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "stripe": "^22.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "prisma": "6.19.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
