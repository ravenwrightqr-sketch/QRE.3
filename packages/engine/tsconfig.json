{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "skipLibCheck": true,

    "declaration": true,
    "declarationMap": true,

    "emitDeclarationOnly": false,

    "types": ["node"],

    "baseUrl": ".",

    "paths": {
      "@qre/contracts": ["../contracts/dist"],
      "@qre/db": ["../db/src"],
      "@qre/api": ["../../apps/api/src"]
    },

    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },

  "exclude": [
    "dist",
    "node_modules",
    "src/cognition/creativePolicy.ts",
    "src/cognition/experienceCritic.ts",
    "src/cognition/mindState.ts",
    "src/cognition/universalMind.ts",
    "src/experience/cognitiveExperienceCompiler.ts",
    "src/experience/cognitiveMechanics.ts",
    "src/experience/cognitiveTrajectory.ts",
    "src/experience/provenanceAwareNarrativeRealizer.ts",
    "src/compiler/universalRealityCompiler.ts",
    "src/compiler/semantic/genome/genomeBuilder.ts",
    "src/compiler/tests/eliteUniversalSentenceAcceptance.ts",
    "src/compiler/tests/geoCognitionAcceptance.ts"
  ]
}