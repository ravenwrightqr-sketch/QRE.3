{
  "name": "@qre/engine",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@qre/api": "workspace:*",
    "@qre/contracts": "workspace:*",
    "@qre/db": "workspace:*",
    "nanoid": "^5.1.16"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:universal-mind": "tsx src/compiler/tests/universalCognitiveMindAcceptance.ts",
    "test:creative-superstar": "tsx src/compiler/tests/creativeSuperstarAcceptance.ts",
    "test:writer-ceiling": "tsx src/compiler/tests/writerCeilingAcceptance.ts",
    "test:writer-readout": "tsx src/compiler/tests/writerReadout.ts",
    "test:runtime-cognition": "tsx src/compiler/tests/runtimeCognitionAcceptance.ts",
    "test:all-cognition": "pnpm run test:universal-mind && pnpm run test:creative-superstar && pnpm run test:writer-ceiling && pnpm run test:runtime-cognition"
  }
}
